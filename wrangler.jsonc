{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoom-to-youtube",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "STORE",
      "bucket_name": "zoom-to-youtube"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
